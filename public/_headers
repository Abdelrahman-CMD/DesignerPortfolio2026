# Bestanden met een hash in hun naam veranderen nooit van inhoud, dus die mogen
# een jaar blijven staan. Deze regel stond in de door vinext gegenereerde versie
# van dit bestand; omdat een eigen _headers die vervangt, hoort hij hier.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Afbeeldingen in public/ hebben geen hash in hun naam, dus een jaar is te lang:
# vervang je een foto onder dezelfde naam, dan blijven bezoekers de oude zien.
# Een maand vangt herhaalbezoek op en houdt de doorlooptijd overzichtelijk.
/about/*
  Cache-Control: public, max-age=2592000

/projects/*
  Cache-Control: public, max-age=2592000

/og-mind-hero.jpg
  Cache-Control: public, max-age=2592000

# Iconen wisselen zelden, maar een week houdt een merkwijziging hanteerbaar.
/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/merk.svg
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/icon-512-maskable.png
  Cache-Control: public, max-age=604800

# Het manifest wijst naar die iconen. Kort houden, anders blijft een oud
# manifest naar een icoon wijzen dat al vervangen is. Zonder het expliciete
# content-type serveert de worker het als octet-stream en slaat Chrome de
# installatiecontrole over.
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8
